@page "/"
@inject NavigationManager NavigationManager
@inject BattleshipGame.Services.GameServiceManager GameServiceManager
@using BattleshipGame.Services
@using Model

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="text-center">Battleship Game Settings</h2>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label for="gridSize">Grid Size:</label>
                        <select id="gridSize" class="form-control" @bind="gridSize">
                            <option value="8">8x8</option>
                            <option value="10">10x10</option>
                            <option value="12">12x12</option>
                            <option value="15">15x15</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="gameMode">Game Mode:</label>
                        <select id="gameMode" class="form-control" @bind="gameMode">
                            <option value="@GameMode.Normal">Normal (Alternating turns)</option>
                            <option value="@GameMode.Pro">Pro (Shoot again after hit)</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label>Ship Configuration:</label>
                        <div class="alert alert-info">
                            <small>Board configuration: @GetUsedGridSpace() / @GetMaximumGridSpace() ship cells</small>
                            @if (IsShipConfigValid())
                            {
                                <div class="text-success"><small>Valid configuration</small></div>
                            }
                            else
                            {
                                <div class="text-danger"><small>Too many ships for this grid size</small></div>
                            }
                        </div>
                        <div class="card p-3">
                            @foreach (var shipConfig in shipConfigurations.OrderByDescending(s => s.Key))
                            {
                                <div class="d-flex align-items-center mb-3">
                                    <div class="me-3 d-flex" style="width: 150px;">
                                        @for (int i = 0; i < shipConfig.Key; i++)
                                        {
                                            <div class="ship-segment bg-primary" style="width: 20px; height: 20px; margin-right: 2px;"></div>
                                        }
                                    </div>
                                    <span class="me-2">Size @shipConfig.Key:</span>
                                    <div class="input-group" style="width: 120px;">
                                        <button class="btn btn-outline-secondary" type="button"
                                                @onclick="() => DecrementShipCount(shipConfig.Key)"
                                                disabled="@(shipConfig.Value <= 0)">
                                            -
                                        </button>
                                        <input type="text" class="form-control text-center" value="@shipConfig.Value" readonly />
                                        <button class="btn btn-outline-secondary" type="button"
                                                @onclick="() => IncrementShipCount(shipConfig.Key)"
                                                disabled="@(!CanAddMoreShips())">
                                            +
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="text-center mt-4">
                        <button class="btn btn-primary btn-lg" @onclick="StartGame" disabled="@(!IsShipConfigValid())">Start Game</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int gridSize = 10;
    private GameMode gameMode = GameMode.Normal;
    private Dictionary<int, int> shipConfigurations = new Dictionary<int, int>
    {
        { 5, 1 },
        { 4, 1 },
        { 3, 2 },
        { 2, 1 },
        { 1, 0 }
    };

    private void StartGame()
    {
        if (!IsShipConfigValid())
            return;

        GameServiceManager.SetGameMode(gameMode);

        var shipConfigString = string.Join(",", shipConfigurations
            .Where(kvp => kvp.Value > 0)
            .SelectMany(kvp => Enumerable.Repeat(kvp.Key, kvp.Value)));

        NavigationManager.NavigateTo($"/game?gridSize={gridSize}&ships={shipConfigString}");
    }

    private int GetUsedGridSpace()
    {
        return shipConfigurations.Sum(kvp => kvp.Key * kvp.Value);
    }

    private int GetMaximumGridSpace()
    {
        return (int)(gridSize * gridSize * 0.3);
    }

    private bool IsShipConfigValid()
    {
        return GetUsedGridSpace() > 0 && GetUsedGridSpace() <= GetMaximumGridSpace();
    }

    private bool CanAddMoreShips()
    {
        return GetUsedGridSpace() < GetMaximumGridSpace();
    }

    private void IncrementShipCount(int shipSize)
    {
        if (CanAddMoreShips())
        {
            shipConfigurations[shipSize]++;
        }
    }

    private void DecrementShipCount(int shipSize)
    {
        if (shipConfigurations[shipSize] > 0)
        {
            shipConfigurations[shipSize]--;
        }
    }
}