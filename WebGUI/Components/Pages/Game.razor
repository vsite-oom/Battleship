@page "/Game"

@rendermode InteractiveServer
@using Vsite.Oom.Battleship.Model

<style>
    .row {
        display: flex;
    }

    .opponent-board-btn:hover {
        background-color: #a67179;
    }

    .my-board, .opponent-board {
        margin: auto;
    }

    .water {
        background-color: lightpink;
    } 

    .square {
        height: 50px;
        width: 50px;
        gap: 2px;
    }

    .btn-pointer {
        cursor: default !important;
    }

    .btn-hover:hover {
        opacity: 0.5;
    }

    .ship {
        background-color: #8a484b;
    }

    .hit-ship {
        background-color: #4f2527;
        cursor: default !important;
        pointer-events: none;
    }

    .hit-water {
        background-color: #3a535e;
        cursor: default !important;
        pointer-events: none;
    }

    .ship-sunken {
        background-color: #323333;
        cursor: default !important;
        pointer-events: none;
    }




</style>
<Modal @ref=modal IsServiceModal="true">
    <FooterTemplate> 
        <Button @onclick = "RestartGame">Restart</Button>
    </FooterTemplate>
</Modal>

<div class="container">
    <div class="boards">
        <div class="my-board">
            @myGrid
        </div>
        <div class="opponent-board">
            @opponentGrid
        </div>
    </div>
    <label class="attacker">@attacker</label>
</div>


@code {
    [Inject] private ModalService modalService { get; set; } = default!;
    [Inject]private NavigationManager navigationManager { get; set; }

    private List<List<Square>> myBoard = new();
    private List<List<Square>> myBoats = new();
    private Gunnery myGunnery = null!;
    private Fleet myFleet = null!;

    private List<List<Square>> opponentBoard = new();
    private List<List<Square>> opponentBoats = new();
    private Gunnery opponentGunnery = null!;
    private Fleet opponentFleet = null!;
    private string attacker = "Your turn...";

    private int boardRows = 10;
    private int boardColumns = 10;
    private int[] ships = { 5, 4, 3, 3, 2 };

    private RenderFragment? myGrid;
    private RenderFragment? opponentGrid;

    private bool AIWon;
    private Modal modal = default!;



    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        InitializeMyBoard();
        InitializeOpponentBoard();
        await FillBoards();
    }

    private void InitializeMyBoard()
    {
        myBoard.Clear();

        FleetBuilder fleetBuilder = new FleetBuilder(boardRows, boardColumns, ships);

        myFleet = fleetBuilder.CreateFleet();

        myGunnery = new Gunnery(boardRows, boardColumns, ships);

        CreateBoards(myBoard, myBoats);

    }

    private void InitializeOpponentBoard()
    {

        opponentBoard.Clear();

        FleetBuilder fleetBuilder = new FleetBuilder(boardRows, boardColumns, ships);

        opponentFleet = fleetBuilder.CreateFleet();

        opponentGunnery = new Gunnery(boardRows, boardColumns, ships);

        CreateBoards(opponentBoard, opponentBoats, true);

    }

    private void CreateBoards(List<List<Square>> board, List<List<Square>> boats, bool isOpponent = false)
    {
        for (int i = 0; i < boardRows; i++)
        {
            List<Square> boardRow = [];
            List<Square> boatsRow = [];

            for (int j = 0; j < boardColumns; j++)
            {
                boardRow.Add(new Square(i, j));
                boatsRow.Add(new Square(i, j));
            }
            board.Add(boardRow);
            boats.Add(boatsRow);
        }

        if (isOpponent)
        {
            foreach (var ship in opponentFleet.Ships)
            {
                foreach (var field in ship.Squares)
                {
                    board[field.Row][field.Column].IsShip = true;
                }
            }
        }
        else
        {
            foreach (var ship in myFleet.Ships)
            {
                foreach (var field in ship.Squares)
                {
                    board[field.Row][field.Column].IsShip = true;
                }
            }
        }
    }

    private async Task FillBoards()
    {
        await FillMyBoard();
        await FillOpponentBoard();
        StateHasChanged();
    }

    private async Task FillMyBoard()
    {
        int d = 0;
        myGrid = builder =>
        {
            foreach (var row in myBoard)
            {
                builder.OpenElement(d++, "div");
                builder.AddAttribute(d++, "class", "row");

                foreach (var square in row) 
                {
                    builder.OpenElement(d++, "Button");
                    string cssFriendClass = square.SquareState switch
                    {
                        SquareState.Hit => "btn-pointer square hit-ship",
                        SquareState.Missed => "btn-pointer square hit-water",
                        SquareState.Sunken => "btn-pointer square ship-sunken",
                        SquareState.Intact => square.IsShip ? "btn-pointer square ship" : "btn-pointer square water",
                        _ => "btn-pointer square water"
                    };
                    builder.AddAttribute(d++, "class", cssFriendClass);
                    builder.AddAttribute(d++, "Disabled", "true");
                    builder.CloseElement();
                }

                builder.CloseElement();
            }
        };
    }

    private async Task FillOpponentBoard() 
    {
        int seq = 0;
        opponentGrid = builder =>
        {
            foreach (var row in opponentBoard)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "row");

                foreach (var field in row)
                {
                    builder.OpenElement(seq++, "button");
                    string cssOpponentClass = field.SquareState switch
                    {
                        SquareState.Hit => "square hit-ship",
                        SquareState.Missed => "square hit-water",
                        SquareState.Sunken => "square ship-sunken",
                        _ => "opponent-board-btn square water"
                    };
                    builder.AddAttribute(seq++, "class", cssOpponentClass);
                    builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () =>
                    {
                        await MyAttack(field);
                    }));
                    builder.CloseElement();
                }

                builder.CloseElement();
            }
        };
    }

    private async Task MyAttack(Square target)
    {
        var hitResult = opponentFleet.Hit(target.Row, target.Column);

        switch (hitResult)
        {
            case HitResult.Hit:
                opponentBoard[target.Row][target.Column].ChangeState(SquareState.Hit);
                break;
            case HitResult.Sunken:
                foreach (var ship in opponentFleet.Ships)
                {
                    if (ship.Squares.Any(s => s.Row == target.Row && s.Column == target.Column))
                    {
                        foreach (var hitSquare in ship.Squares)
                        {
                            opponentBoard[hitSquare.Row][hitSquare.Column].ChangeState(SquareState.Sunken);
                        }
                        break;
                    }
                }
                break;
            default:
                opponentBoard[target.Row][target.Column].ChangeState(SquareState.Missed);
                break;
        }

        StateHasChanged();

        if (!IsGameOver())
        {
            attacker = "Opponent is thinking...";
            StateHasChanged();
            await Task.Delay(500); 

            await OpponentAttack();
        }
        else
        {
            AIWon = false;
            await ShowGameOverModal();
            attacker = "Game Over!";
            StateHasChanged();
        }
    }

    private async Task OpponentAttack()
    {
        var target = opponentGunnery.Next();
        var hitResult = myFleet.Hit(target.Row, target.Column);

        opponentGunnery.ProcessHitResult(hitResult);

        switch (hitResult)
        {
            case HitResult.Hit:
                myBoard[target.Row][target.Column].ChangeState(SquareState.Hit);
                break;
            case HitResult.Sunken:
                foreach (var ship in myFleet.Ships)
                {
                    if (ship.Squares.Any(s => s.Row == target.Row && s.Column == target.Column))
                    {
                        foreach (var hitSquare in ship.Squares)
                        {
                            myBoard[hitSquare.Row][hitSquare.Column].ChangeState(SquareState.Sunken);
                        }
                        break;
                    }
                }
                break;
            default:
                myBoard[target.Row][target.Column].ChangeState(SquareState.Missed);
                break;
        }

        StateHasChanged();

        if (!IsGameOver())
        {
            attacker = "Your turn...";
            StateHasChanged();
        }
        else
        {
            AIWon = true;
            await ShowGameOverModal();
            attacker = "Game Over!";
            StateHasChanged();
        }
    }

    private bool IsGameOver()
    {
        var playerLost = myFleet.Ships.SelectMany(s => s.Squares).All(ship => ship.SquareState != SquareState.Intact);
        var enemyLost = opponentFleet.Ships.SelectMany(s => s.Squares).All(ship => ship.SquareState != SquareState.Intact);

        return playerLost || enemyLost;
    }

    private async Task ShowGameOverModal()
    {
        string winnerText = AIWon ? "Computer" : "You";
        var modalOption = new ModalOptions
            {
                Title = "GAME OVER",
                Type = ModalType.Dark,
                Message = $"Game over! {winnerText} won!",
                OnFooterButtonClick = EventCallback.Factory.Create(this, async () => await RestartGame()),
                IsVerticallyCentered = true,
            };
        await modalService.ShowAsync(modalOption);
    }

    private class ModalOptions : ModalOption
    {
        public EventCallback OnFooterButtonClick { get; set; }
    }

    private async Task RestartGame()
    {
        await modal.HideAsync();
        navigationManager.NavigateTo("/");
    }
}
