<Window x:Class="BattleshipWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battleship Game" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    
    <Grid Background="MidnightBlue">
        <!-- Ship Statistics in Top Corners -->
        <!-- Player Ship Stats - Top Left -->
        <StackPanel Orientation="Vertical" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Margin="15,10,0,0">
            <TextBlock Text="Player Ships sunk" 
                      FontSize="16" 
                      FontWeight="Bold" 
                      Foreground="White" 
                      TextAlignment="Left" 
                      Margin="0,0,0,8"/>
            <TextBlock x:Name="PlayerCarrierLabel" 
                      Text="Carrier: 0/1" 
                      FontSize="14" 
                      Foreground="White" 
                      TextAlignment="Left" 
                      Margin="0,1"/>
            <TextBlock x:Name="PlayerBattleshipLabel" 
                      Text="Battleship: 0/2" 
                      FontSize="14" 
                      Foreground="White" 
                      TextAlignment="Left" 
                      Margin="0,1"/>
            <TextBlock x:Name="PlayerCruiserLabel" 
                      Text="Cruiser: 0/3" 
                      FontSize="14" 
                      Foreground="White" 
                      TextAlignment="Left" 
                      Margin="0,1"/>
            <TextBlock x:Name="PlayerPatrolBoatLabel" 
                      Text="Patrol Boat: 0/4" 
                      FontSize="14" 
                      Foreground="White" 
                      TextAlignment="Left" 
                      Margin="0,1"/>
        </StackPanel>
        
        <!-- Computer Ship Stats - Top Right -->
        <StackPanel Orientation="Vertical" 
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Top"
                   Margin="0,10,15,0">
            <TextBlock Text="Computer Ships sunk" 
                      FontSize="16" 
                      FontWeight="Bold" 
                      Foreground="White" 
                      TextAlignment="Right" 
                      Margin="0,0,0,8"/>
            <TextBlock x:Name="ComputerCarrierLabel" 
                      Text="Carrier: 0/1" 
                      FontSize="14" 
                      Foreground="White" 
                      TextAlignment="Right" 
                      Margin="0,1"/>
            <TextBlock x:Name="ComputerBattleshipLabel" 
                      Text="Battleship: 0/2" 
                      FontSize="14" 
                      Foreground="White" 
                      TextAlignment="Right" 
                      Margin="0,1"/>
            <TextBlock x:Name="ComputerCruiserLabel" 
                      Text="Cruiser: 0/3" 
                      FontSize="14" 
                      Foreground="White" 
                      TextAlignment="Right" 
                      Margin="0,1"/>
            <TextBlock x:Name="ComputerPatrolBoatLabel" 
                      Text="Patrol Boat: 0/4" 
                      FontSize="14" 
                      Foreground="White" 
                      TextAlignment="Right" 
                      Margin="0,1"/>
        </StackPanel>

        <!-- Center everything vertically and horizontally -->
		<StackPanel Orientation="Vertical" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center">

			<!-- Header -->
            <StackPanel Orientation="Vertical" Margin="20,0,20,30" 
                       HorizontalAlignment="Center">
                <TextBlock x:Name="StatusLabel" Text="Click 'New Game' to start" 
                          FontSize="24" FontWeight="Bold" Foreground="White" 
                          TextAlignment="Center" Margin="0,0,0,15"/>
                <Button x:Name="NewGameButton" Content="New Game" 
                       Click="NewGameButton_Click" FontSize="16" 
                       Background="#3b82f6" Foreground="White" 
                       BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="8" 
                                    BorderThickness="0"
                                    Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            
            <!-- Grid Labels -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15">
                <TextBlock Text="Your Fleet" FontSize="22" FontWeight="Bold" 
                          Foreground="White" TextAlignment="Center" 
                          Margin="0,0,100,0" Width="400"/>
                <TextBlock Text="Hostile Waters" FontSize="22" FontWeight="Bold" 
                          Foreground="White" TextAlignment="Center" 
                          Width="400"/>
            </StackPanel>
            
            <!-- Game Grids -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center">
                
                <!-- Player Grid -->
                <Border x:Name="PlayerGridBorder" 
                        Background="#1f2937" 
                        CornerRadius="10" 
                        Padding="15" 
                        Margin="0,0,50,0"
                        BorderBrush="Gray"
                        BorderThickness="4">
                    <UniformGrid x:Name="PlayerGrid" Rows="10" Columns="10"/>
                </Border>
                
                <!-- Computer Grid -->
                <Border x:Name="ComputerGridBorder" 
                        Background="#1f2937" 
                        CornerRadius="10" 
                        Padding="15" 
                        Margin="50,0,0,0"
                        BorderBrush="Gray"
                        BorderThickness="4">
                    <UniformGrid x:Name="ComputerGrid" Rows="10" Columns="10"/>
                </Border>
                
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
