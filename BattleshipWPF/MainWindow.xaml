<Window x:Class="BattleshipWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battleship Game" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    
    <Grid Background="#1e3a8a">
        <!-- Center everything vertically and horizontally -->
		<StackPanel Orientation="Vertical" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center">

			<!-- Header -->
            <StackPanel Orientation="Vertical" Margin="20,0,20,30" 
                       HorizontalAlignment="Center">
                <TextBlock x:Name="StatusLabel" Text="Click 'New Game' to start" 
                          FontSize="20" FontWeight="Bold" Foreground="White" 
                          TextAlignment="Center" Margin="0,0,0,15"/>
                <Button x:Name="NewGameButton" Content="New Game" 
                       Click="NewGameButton_Click" FontSize="16" 
                       Background="#3b82f6" Foreground="White" 
                       BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="8" 
                                    BorderThickness="0"
                                    Padding="10,5">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            
            <!-- Grid Labels -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15">
                <TextBlock Text="Your Fleet" FontSize="16" FontWeight="Bold" 
                          Foreground="White" TextAlignment="Center" 
                          Margin="0,0,100,0" Width="400"/>
                <TextBlock Text="Enemy Waters" FontSize="16" FontWeight="Bold" 
                          Foreground="White" TextAlignment="Center" 
                          Width="400"/>
            </StackPanel>
            
            <!-- Game Grids -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center">
                
                <!-- Player Grid -->
                <Border Background="#1f2937" CornerRadius="10" Padding="15" Margin="0,0,50,0">
                    <UniformGrid x:Name="PlayerGrid" Rows="10" Columns="10"/>
                </Border>
                
                <!-- Computer Grid -->
                <Border Background="#1f2937" CornerRadius="10" Padding="15" Margin="50,0,0,0">
                    <UniformGrid x:Name="ComputerGrid" Rows="10" Columns="10"/>
                </Border>
                
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
