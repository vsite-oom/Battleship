@page "/"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject NavigationManager NavigationManager
@using System.Collections.Generic

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-8">
            <div class="card shadow-sm">
                <div class="title">
                    <h2 class="mb-0">Welcome to Battleship!</h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h5>Player 1 Name</h5>
                                <input @bind="player1Name" class="form-control mb-3" placeholder="Enter Player 1 name" />
                            </div>

                            <div class="mb-4">
                                <h5>Player 2 Name</h5>
                                <input @bind="player2Name" class="form-control mb-3" placeholder="Enter Player 2 name" />
                            </div>

                            <h5>Select Grid Size</h5>
                            <div class="d-flex flex-column gap-2 mb-4">
                                @foreach (var size in new int[] { 8, 9, 10, 11, 12 })
                                {
                                    <button type="button"
                                            class="grid-size-btn @(gridSize == size ? "selected" : "")"
                                            @onclick="() => { gridSize = size; isSizeSelected = true; }">
                                        @size x @size
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5>Ship Sizes</h5>
                            <div class="d-flex flex-column gap-3 mb-4">
                                @for (int i = 0; i < shipLengths.Count; i++)
                                {
                                    <div class="ship-card p-3 rounded shadow-sm">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="ship-size text-muted">Size: @shipLengths[i]</div>
                                        </div>
                                        <div class="ship-visual d-flex justify-content-center">
                                            @for (int j = 0; j < shipLengths[i]; j++)
                                            {
                                                <div class="ship-segment custom-bg-info rounded me-1" style="width:20px; height:20px;"></div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    @if (string.IsNullOrWhiteSpace(player1Name) || string.IsNullOrWhiteSpace(player2Name))
                    {
                        <div class="alert alert-warning mb-3 title">
                            Please enter both players' names to continue.
                        </div>
                    }
                    @if (!isSizeSelected)
                    {
                        <div class="alert alert-warning mb-3 title">
                            Please select a grid size to continue.
                        </div>
                    }
                    <button class="grid-size-btn w-100 btn-lg"
                            disabled="@(!isSizeSelected || string.IsNullOrEmpty(player1Name) || string.IsNullOrEmpty(player2Name))"
                            @onclick="StartGame">
                        Start Game
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int? gridSize = null;
    private bool isSizeSelected = false;
    private string player1Name = string.Empty;
    private string player2Name = string.Empty;
    private List<int> shipLengths = new() { 5, 4, 3, 2, 1 };

    private void StartGame()
    {
        if (!gridSize.HasValue || string.IsNullOrEmpty(player1Name) || string.IsNullOrEmpty(player2Name)) return;

        var shipSizes = string.Join(",", shipLengths);
        NavigationManager.NavigateTo($"/game?gridSize={gridSize.Value}&ships={shipSizes}&player1={Uri.EscapeDataString(player1Name)}&player2={Uri.EscapeDataString(player2Name)}");
    }
}